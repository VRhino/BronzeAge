{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bronzeage-servidor",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "--release", "-p", "servicio"],
      "env": {
        "ADMINISTRADORES": "jefa",
        "CODIGO_REGISTRO_BOTS": "dev-bots",
        "BRONZEAGE_DATOS": "datos"
      },
      "port": 7878
    },
    {
      "name": "bronzeage-bots",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "--release"],
      "cwd": "../BronceAgeBotsBrain",
      "env": {
        "CODIGO_REGISTRO_BOTS": "dev-bots"
      },
      "port": 4000
    },
    {
      "name": "bronzeage-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "../BronceAgeAdminClient",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "bronzeage-cliente-jugador",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "../BronzeAgeClient",
      "port": 5174,
      "autoPort": true
    }
  ]
}
