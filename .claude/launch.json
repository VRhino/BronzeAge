{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bronzeage-servidor",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--release",
        "-p",
        "servicio"
      ],
      "port": 7878
    },
    {
      "name": "generar-mundo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/generar-mundo.mjs"
      ],
      "cwd": "."
    },
    {
      "name": "bronzeage-bots",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--release"
      ],
      "cwd": "../BronceAgeBotsBrain",
      "port": 4000
    },
    {
      "name": "bronzeage-bots-mercenarios",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--release"
      ],
      "cwd": "../BronceAgeBotsBrain",
      "env": {
        "BOTS_POBLACION": "mercenarios"
      },
      "port": 4001
    },
    {
      "name": "bronzeage-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "../BronceAgeAdminClient",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "bronzeage-cliente-jugador",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "../BronzeAgeClient",
      "port": 5174,
      "autoPort": true
    }
  ]
}
