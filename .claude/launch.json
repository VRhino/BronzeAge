{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bronze-age-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "server"
      ],
      "env": {
        "ADMINISTRADORES": "dev:jefa",
        "INTERVALO_TICK_MS": "5000"
      },
      "port": 3000
    },
    {
      "name": "bronze-age-cliente",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "cliente",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "bronze-age-cliente-jugador",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "cliente-jugador",
        "run",
        "dev"
      ],
      "env": {
        "VITE_USUARIO": "ana",
        "VITE_GAME_ID": "local"
      },
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "lab-trazado",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "lab"
      ],
      "port": 5180
    }
  ]
}
